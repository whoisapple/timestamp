{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TimeStamp",
  "version": "0.0.1",
  "identifier": "com.ais.timestamp",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TimeStamp",
        "width": 1440,
        "height": 1024,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/whoisapple/timestamp-updates/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIwQjQzRDU0QjE4QUIxN0YKUldSL3NZcXhWRDIwc0ZWN0FtVDJIanpsVWtMbmZnWHB1aTJ1VFR1ZncwNFFsdi85Sm0vTWt2SkMK"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
  
}
